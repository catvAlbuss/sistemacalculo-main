APP_NAME=Laravel

# Image exports: installed Chrome/Chromium/Edge, Node.js >= 22. No Puppeteer needed.
CAPTURE_NODE_BINARY=node
CAPTURE_BROWSER_BINARY=
CAPTURE_DISABLE_SANDBOX=false
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sistemacalculo
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ADMIN_ADDRESS=admon.construyehco@gmail.com
MAIL_TIMEOUT=10
MAIL_DELIVERY_ATTEMPTS=2
MAIL_RETRY_DELAY_MS=250

# Gmail: usa smtp.gmail.com, puerto 587, TLS y una contraseña de aplicación.
# La aplicación elimina automáticamente los espacios que Google muestra en ella.
# Para una segunda salida SMTP, completa estas variables y usa MAIL_MAILER=failover.
MAIL_BACKUP_HOST=
MAIL_BACKUP_PORT=587
MAIL_BACKUP_USERNAME=
MAIL_BACKUP_PASSWORD=
MAIL_BACKUP_ENCRYPTION=tls
MAIL_BACKUP_TIMEOUT=10

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Culqi: usar llaves de integración propias; nunca copiar las de otro comercio.
CULQI_ENABLED=false
CULQI_INCLUDE_PROCESSING=true
CULQI_PROCESSING_PERCENT=3.99
CULQI_PROCESSING_FIXED_USD=0.20
CULQI_PROCESSING_FIXED_PEN=
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
CULQI_WEBHOOK_TOKEN=

# Datos reales del emisor para el ticket interno y la futura emisión electrónica.
BILLING_ISSUER_NAME="RIZABAL & ASOCIADOS INGENIEROS ESTRUCTURALES S.A.C."
BILLING_ISSUER_RUC=20609317061
BILLING_ISSUER_ADDRESS="Av. Javier Heraud N.° 110, sector San Luis, Amarilis, Huánuco, Huánuco"
BILLING_ISSUER_UBIGEO=100102
BILLING_ISSUER_EMAIL=admon.construyehco@gmail.com
BILLING_IGV_RATE=18

# Atención al consumidor; si se omite el correo, se usa el del emisor o MAIL_ADMIN_ADDRESS.
LEGAL_CONTACT_EMAIL=admon.construyehco@gmail.com
LEGAL_CONTACT_PHONE=51962999500

# Consulta de DNI/RUC (ApiPeru): llave propia, usada solo en el servidor.
API_PERU_TOKEN=
PAYMENTS_QUEUE_CONNECTION=payments

# Videos: FFmpeg/FFprobe deben existir en el servidor. Procesamiento aislado de pagos.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_QUEUE_CONNECTION=media
