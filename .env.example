APP_NAME=Laravel

# Image exports: installed Chrome/Chromium/Edge, Node.js >= 22. No Puppeteer needed.
CAPTURE_NODE_BINARY=node
CAPTURE_BROWSER_BINARY=
CAPTURE_DISABLE_SANDBOX=false
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sistemacalculo
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Respaldos de proyectos (versión 2.0). Apagado: oculta la función y pausa la copia nocturna; no borra copias.
PROJECT_BACKUPS_ENABLED=false

# Producción: buzón de Hostinger como remitente único (MAIL_FROM_ADDRESS = MAIL_USERNAME).
# MAIL_MAILER=smtp, MAIL_HOST=smtp.hostinger.com, MAIL_PORT=465, MAIL_USERNAME=admon.construyehco@gespro.io
# El puerto 465 usa SSL por sí solo. MAIL_ADMIN_ADDRESS recibe la copia de cada comprobante.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ADMIN_ADDRESS=admon.construyehco@gmail.com
MAIL_TIMEOUT=10
MAIL_DELIVERY_ATTEMPTS=2
MAIL_RETRY_DELAY_MS=250

# Gmail: usa smtp.gmail.com, puerto 587, TLS y una contraseña de aplicación.
# La aplicación elimina automáticamente los espacios que Google muestra en ella.
# Para una segunda salida SMTP, completa estas variables y usa MAIL_MAILER=failover.
MAIL_BACKUP_HOST=
MAIL_BACKUP_PORT=587
MAIL_BACKUP_USERNAME=
MAIL_BACKUP_PASSWORD=
MAIL_BACKUP_ENCRYPTION=tls
MAIL_BACKUP_TIMEOUT=10

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Culqi: usar llaves de integración propias; nunca copiar las de otro comercio.
CULQI_ENABLED=false
CULQI_INCLUDE_PROCESSING=true
CULQI_PROCESSING_PERCENT=3.99
CULQI_PROCESSING_FIXED_USD=0.20
CULQI_PROCESSING_FIXED_PEN=
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
CULQI_WEBHOOK_TOKEN=
# Revisión del comercio por Culqi: llaves test en producción solo para estas cuentas (separadas por comas).
# Desactivar al recibir las llaves live.
CULQI_REVIEW_MODE=false
CULQI_REVIEWER_EMAILS=

# Datos reales del emisor para el ticket interno y la futura emisión electrónica.
BILLING_ISSUER_NAME="RIZABAL & ASOCIADOS INGENIEROS ESTRUCTURALES S.A.C."
BILLING_ISSUER_RUC=20609317061
BILLING_ISSUER_ADDRESS="Av. Javier Heraud N.° 110, sector San Luis, Amarilis, Huánuco, Huánuco"
BILLING_ISSUER_UBIGEO=100102
BILLING_ISSUER_EMAIL=admon.construyehco@gmail.com
BILLING_IGV_RATE=18

# Atención al consumidor; si se omite el correo, se usa el del emisor o MAIL_ADMIN_ADDRESS.
LEGAL_CONTACT_EMAIL=admon.construyehco@gmail.com
LEGAL_CONTACT_PHONE=51962999500

# Consulta de DNI/RUC (ApiPeru): llave propia, usada solo en el servidor.
API_PERU_TOKEN=
PAYMENTS_QUEUE_CONNECTION=payments

# Videos: FFmpeg/FFprobe deben existir en el servidor. Procesamiento aislado de pagos.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_QUEUE_CONNECTION=media

# Motor Octave (config/octave.php). Linux: paquete snap. Windows: octave-cli.exe nativo o, si no hay,
# el mismo paquete Linux ejecutado con WSL.
OCTAVE_SNAP_PATH=/home/u112634954/domains/ryaie.com/octave
OCTAVE_WINDOWS_CLI_PATH=
OCTAVE_USE_WSL=true
OCTAVE_WSL_DISTRO=
OCTAVE_WSL_SNAP_PATH='C:\laragon\www\octave'

# API de planos CAD. El token debe coincidir con API_TOKEN del servicio.
CAD_API_URL=https://api-cad.onrender.com
CAD_API_TOKEN=
CAD_API_TIMEOUT=90

# Agente NovaCad (config/services.php → agente_llm). La clave vive solo aquí, en el servidor:
# el navegador habla con /software/etabs/agente/llm y nunca la ve.
# Proveedor: openai | gemini | grok | ollama (local, sin clave).
AGENTE_LLM_PROVEEDOR=openai
AGENTE_LLM_KEY=
# auto: el servidor elige por pedido. Empieza por el primero de AGENTE_LLM_MODELOS (el más
# barato) y solo si su respuesta no sirve pasa al siguiente. También se puede fijar un modelo.
AGENTE_LLM_MODEL=auto
AGENTE_LLM_MODELOS=gpt-4.1-mini,gpt-4.1
# Tope diario de tokens de todo el despacho (0 = sin tope) y pedidos por usuario por minuto.
AGENTE_LLM_TOKENS_DIA=2000000
AGENTE_LLM_POR_MINUTO=20
AGENTE_LLM_MAX_TOKENS=1500
AGENTE_LLM_TIMEOUT=90
# Modelos de razonamiento (GPT-5/6, o3): esfuerzo de razonamiento (low ahorra tokens).
AGENTE_LLM_RAZONAMIENTO=low
# auto | true | false: si el modelo recibe las fotos de las observaciones.
AGENTE_LLM_VISION=auto
# Opcionales: AGENTE_LLM_URL (otro servidor compatible con OpenAI), AGENTE_LLM_MEMORIA=auto|completa|corta
