# Configuracion para copiar al servidor de produccion.
# Completar Hostinger Mail y revisar BD + llaves Culqi live antes de activar.
# Despues: php artisan config:clear; php artisan config:cache; php artisan queue:restart

# APLICACION - perfil de produccion. APP_KEY: conservar la del servidor, no regenerarla.
APP_NAME=RYAIE
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Lima
APP_URL=https://ryaie.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# LOGS
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# BASE DE DATOS - revisar estos datos en hPanel antes de copiar. root/sistemacalculo son valores locales.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# SESIONES, CACHE Y COLAS - configurar cron y worker payments en el servidor.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
PAYMENTS_QUEUE_CONNECTION=payments
MEDIA_QUEUE_CONNECTION=media
CACHE_STORE=database
CACHE_PREFIX=
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
PROJECT_BACKUPS_ENABLED=false

# HOSTINGER MAIL API - completar TOKEN, ID y ADDRESS con los datos reales del mismo buzon.
HOSTINGER_MAIL_API_TOKEN=
HOSTINGER_MAILBOX_ID=AC8aee06db75f6c72504e0358b0a80
HOSTINGER_MAILBOX_ADDRESS=admon.construyehco@gespro.io
MAIL_MAILER=hostinger
MAIL_FROM_ADDRESS="${HOSTINGER_MAILBOX_ADDRESS}"
MAIL_FROM_NAME="Rizabal & Asociados"
MAIL_ADMIN_ADDRESS=admon.construyehco@gmail.com
MAIL_TIMEOUT=10
MAIL_DELIVERY_ATTEMPTS=2
MAIL_RETRY_DELAY_MS=250

# SMTP OPCIONAL - no se utiliza con MAIL_MAILER=hostinger. Se conservan tus credenciales anteriores en .env.
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_BACKUP_HOST=
MAIL_BACKUP_PORT=587
MAIL_BACKUP_USERNAME=
MAIL_BACKUP_PASSWORD=
MAIL_BACKUP_ENCRYPTION=tls
MAIL_BACKUP_TIMEOUT=10

# CULQI - para cobros reales usar pk_live y sk_live del comercio. Las llaves test conservadas no permiten cobrar en este perfil.
CULQI_ENABLED=true
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
CULQI_WEBHOOK_TOKEN=
CULQI_INCLUDE_PROCESSING=true
CULQI_PROCESSING_PERCENT=3.99
CULQI_PROCESSING_FIXED_USD=0.20
CULQI_PROCESSING_FIXED_PEN=
CULQI_REVIEW_MODE=false
CULQI_REVIEWER_EMAILS=

# EMISOR Y CONTACTO - datos de los tickets y documentos. IGV incluido en el precio.
BILLING_ISSUER_NAME="RIZABAL & ASOCIADOS INGENIEROS ESTRUCTURALES S.A.C."
BILLING_ISSUER_RUC=20609317061
BILLING_ISSUER_ADDRESS="Av. Javier Heraud N.° 110, sector San Luis, Amarilis, Huánuco, Huánuco"
BILLING_ISSUER_UBIGEO=100102
BILLING_ISSUER_EMAIL=admon.construyehco@gmail.com
BILLING_IGV_RATE=18
LEGAL_CONTACT_EMAIL=admon.construyehco@gmail.com
LEGAL_CONTACT_PHONE=51962999500
API_PERU_TOKEN=

# VIDEOS Y OCTAVE - verificar que estos ejecutables y rutas existan en el hosting Linux.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
OCTAVE_SNAP_PATH=/home/u112634954/domains/ryaie.com/octave
OCTAVE_WINDOWS_CLI_PATH=
OCTAVE_USE_WSL=false
OCTAVE_WSL_DISTRO=
OCTAVE_WSL_SNAP_PATH='C:\laragon\www\octave'

# CAD Y AGENTE IA - conservar las claves existentes; nunca enviarlas al navegador.
CAD_API_URL=https://api-cad.onrender.com
CAD_API_TOKEN=
CAD_API_TIMEOUT=90
AGENTE_LLM_PROVEEDOR=openai
AGENTE_LLM_KEY=
AGENTE_LLM_MODEL=auto
AGENTE_LLM_MODELOS=gpt-4.1-mini,gpt-4.1
AGENTE_LLM_VISION=auto
AGENTE_LLM_TOKENS_DIA=2000000
AGENTE_LLM_POR_MINUTO=20
AGENTE_LLM_MAX_TOKENS=1500
AGENTE_LLM_TIMEOUT=90
AGENTE_LLM_RAZONAMIENTO=low
AGENTE_BIBLIOTECA_ACTIVA=false
AGENTE_BIBLIOTECA_ROLES=root,gerencia,asistente

# ALMACENAMIENTO Y FRONTEND
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
VITE_APP_NAME="${APP_NAME}"
CAPTURE_NODE_BINARY=node
CAPTURE_BROWSER_BINARY=
CAPTURE_DISABLE_SANDBOX=false

# Cuentas con el plan vencido sin renovar: aviso un día antes y baja lógica (no borra datos).
SUBSCRIPTIONS_BAJA_AUTOMATICA=true
SUBSCRIPTIONS_DIAS_PARA_BAJA=7
